# =====================================================================
# Zonostick - Environment Variables
# Copy this file to .env.local (for local dev) and fill in real values.
# In production (Vercel), set these under Project Settings > Environment Variables.
# =====================================================================

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
# Public URL of the deployed app (used for Stripe redirect URLs, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Supabase
# https://app.supabase.com/project/_/settings/api
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key - server-only, NEVER expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------
# LLM Providers - used by lib/geo-engine.ts
# ---------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# gpt-5.6-luna, not gpt-4o (2026-09 model-currency sweep) - gpt-4o was
# still answering 200 OK but only as OpenAI's own "grandfathered legacy
# pricing," no longer on the current pricing page at all. Luna is the
# cost-optimized tier of the current GPT-5.6 generation - $0.20/$1.20
# per 1M tokens vs. gpt-4o's $2.50/$10 - the same cost/accuracy
# tradeoff already made for Claude (Haiku over Sonnet), applied
# consistently. See lib/geo-engine.ts callChatGPT's own comment for why
# this model rejects a `temperature` override.
OPENAI_MODEL=gpt-5.6-luna
# Cheap model used once per provider result to judge sentiment + rank
# (see lib/geo-engine.ts judgeBrandTreatment). Reuses OPENAI_API_KEY above.
OPENAI_JUDGE_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=sk-ant-...
# Haiku, not Sonnet (2026-09) - at production prompt/brand volume,
# Sonnet's per-call cost blew through the Anthropic workspace's
# monthly spend cap in days (see lib/geo-engine.ts callClaude's own
# comment). Haiku is the deliberate cost/accuracy tradeoff for this
# specific task (mention/rank detection from a markdown-formatted
# answer, not open-ended reasoning) - reconsider only with a real
# accuracy regression in hand, not preemptively.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

PERPLEXITY_API_KEY=pplx-...
PERPLEXITY_MODEL=sonar-pro

GEMINI_API_KEY=AIza...
# gemini-3.8-flash, not gemini-3.6-flash (2026-09 model-currency sweep)
# - a pure generation bump (identical $0.75/$3.75 per 1M rate either
# way), not a cost decision like the other three provider changes in
# this same sweep. 3.6 was still current-pricing, just one generation
# behind Google's "New Stable" Flash release.
GEMINI_MODEL=gemini-3.8-flash

XAI_API_KEY=xai-...
# grok-4.3, not grok-4 (2026-09 model-currency sweep) - "grok-4" had
# already quietly stopped being a real model id (absent from xAI's own
# docs); a live call requesting it came back `"model": "grok-4.3"` in
# the response, meaning the account was being silently rerouted the
# whole time with nothing surfacing that fact. Naming grok-4.3
# explicitly - not xAI's current flagship grok-4.6, notably pricier at
# $2-4/$6-12 vs grok-4.3's $1.25/$2.50 - keeps exactly the model this
# account was already actually being served.
GROK_MODEL=grok-4.3

DEEPSEEK_API_KEY=sk-...
# deepseek-v4-flash, not deepseek-chat (2026-09 model-currency sweep) -
# same silent-rerouting situation as Grok above: "deepseek-chat" isn't
# a valid model id in DeepSeek's current docs at all, and a live call
# requesting it came back `"model": "deepseek-v4-flash"`. Naming that
# explicitly now, not the pricier deepseek-v4-pro, keeps the exact
# model this account was already being served.
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------
# Monthly LLM-provider spend guard (2026-09) - see lib/cost-budget.ts
# and lib/provider-pricing.ts. Every check's real $ cost is recorded on
# its own rankings row (cost_usd); once this env var is set, the daily
# cron sums this JST-calendar-month's total after each run and alerts
# FEEDBACK_SLACK_WEBHOOK_URL (the operator's own admin channel, not any
# customer's) at 70% of budget and again once it's actually exceeded.
# Left unset, the check is skipped entirely - there is deliberately no
# built-in default number here; pick one that reflects this business's
# real subscriber count/plan mix, not a guess. As of the 2026-09 cost
# audit, real system-wide spend at 29 active prompts was ~$20/month -
# size this against actual + expected near-term subscriber growth, not
# today's number alone.
MONTHLY_LLM_BUDGET_USD=

# ---------------------------------------------------------------------
# Cron / Job security
# Used to authenticate calls to /api/cron/daily-check (Vercel Cron or
# Upstash QStash). Send as: Authorization: Bearer <CRON_SECRET>
# ---------------------------------------------------------------------
CRON_SECRET=replace-with-a-long-random-string

# Optional: Upstash QStash (if using QStash instead of / in addition to Vercel Cron)
# https://console.upstash.com/qstash
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---------------------------------------------------------------------
# Stripe
# https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for each paid plan (create in Stripe Dashboard > Product catalog)
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_BUSINESS=price_...

# ---------------------------------------------------------------------
# Slack (fallback/default webhook - users can also set their own per-account
# webhook from the dashboard, stored in profiles.slack_webhook_url)
# https://api.slack.com/messaging/webhooks
# ---------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# ---------------------------------------------------------------------
# Sentry (error tracking - see sentry.*.config.ts / instrumentation.ts)
# https://sentry.io - create a Next.js project, then Settings > Client Keys (DSN)
# Left unset, Sentry.init() no-ops (nothing captured, no error) - safe to
# leave blank for local dev.
# ---------------------------------------------------------------------
# Public by design - a DSN only lets a client SEND events, not read them.
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXXXX.ingest.us.sentry.io/XXXXXXX
# Only needed at build time (e.g. on Vercel) to upload source maps so
# stack traces show real file/line numbers instead of minified output.
# Settings > Auth Tokens > create with "project:releases" scope.
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=sntrys_...
