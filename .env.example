# =====================================================================
# Zonostick - Environment Variables
# Copy this file to .env.local (for local dev) and fill in real values.
# In production (Vercel), set these under Project Settings > Environment Variables.
# =====================================================================

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
# Public URL of the deployed app (used for Stripe redirect URLs, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Supabase
# https://app.supabase.com/project/_/settings/api
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key - server-only, NEVER expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------
# LLM Providers - used by lib/geo-engine.ts
# ---------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Cheap model used once per provider result to judge sentiment + rank
# (see lib/geo-engine.ts judgeBrandTreatment). Reuses OPENAI_API_KEY above.
OPENAI_JUDGE_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

PERPLEXITY_API_KEY=pplx-...
PERPLEXITY_MODEL=sonar-pro

GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.6-flash

XAI_API_KEY=xai-...
GROK_MODEL=grok-4

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------
# Cron / Job security
# Used to authenticate calls to /api/cron/daily-check (Vercel Cron or
# Upstash QStash). Send as: Authorization: Bearer <CRON_SECRET>
# ---------------------------------------------------------------------
CRON_SECRET=replace-with-a-long-random-string

# Optional: Upstash QStash (if using QStash instead of / in addition to Vercel Cron)
# https://console.upstash.com/qstash
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---------------------------------------------------------------------
# Stripe
# https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for each paid plan (create in Stripe Dashboard > Product catalog)
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_BUSINESS=price_...

# ---------------------------------------------------------------------
# Slack (fallback/default webhook - users can also set their own per-account
# webhook from the dashboard, stored in profiles.slack_webhook_url)
# https://api.slack.com/messaging/webhooks
# ---------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# ---------------------------------------------------------------------
# Sentry (error tracking - see sentry.*.config.ts / instrumentation.ts)
# https://sentry.io - create a Next.js project, then Settings > Client Keys (DSN)
# Left unset, Sentry.init() no-ops (nothing captured, no error) - safe to
# leave blank for local dev.
# ---------------------------------------------------------------------
# Public by design - a DSN only lets a client SEND events, not read them.
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXXXX.ingest.us.sentry.io/XXXXXXX
# Only needed at build time (e.g. on Vercel) to upload source maps so
# stack traces show real file/line numbers instead of minified output.
# Settings > Auth Tokens > create with "project:releases" scope.
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=sntrys_...
